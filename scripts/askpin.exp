#!/usr/bin/expect -f
#
# askpin.exp – OpenVPN expect wrapper script
# ===========================================

set ovpn_file [lindex $argv 0]
set rules_file [lindex $argv 1]
set debug_log [lindex $argv 2]

if {$ovpn_file eq ""} {
    puts stderr "Usage: askpin.exp <ovpn_file> ?rules_file? ?debug_log?"
    exit 1
}

if {$debug_log ne ""} {
    if {[catch {log_file -noappend $debug_log} log_err]} {
        puts stderr "askpin: failed to open debug log: $log_err"
    } else {
        exp_internal 1
        puts "askpin: debug logging enabled: $debug_log"
        flush stdout
    }
}

proc unescape_rule_field {value} {
    return [string map [list "\\\\t" "\t" "\\\\n" "\n" "\\\\r" "\r" "\\\\" "\\"] $value]
}

proc load_rules {path} {
    if {$path eq ""} {
        return {}
    }

    if {![file exists $path]} {
        return {}
    }

    set fh [open $path r]
    set content [read $fh]
    close $fh

    set rules {}
    foreach line [split $content "\n"] {
        if {$line eq ""} {
            continue
        }

        set fields [split $line "\t"]
        if {[llength $fields] != 3} {
            continue
        }

        set prompt [unescape_rule_field [lindex $fields 0]]
        set type [unescape_rule_field [lindex $fields 1]]
        set value [unescape_rule_field [lindex $fields 2]]

        if {$prompt eq ""} {
            continue
        }
        if {$type ne "static" && $type ne "prompt"} {
            continue
        }

        lappend rules [list $prompt $type $value]
    }

    return $rules
}

proc literal_to_regex {text} {
    set escaped $text
    regsub -all {[][(){}.*+?^$\\|]} $escaped {\\&} escaped
    return $escaped
}

proc get_secret {title description prompt_label} {
    global spawn_id

    set esc_title [string map {% %25 \n " "} $title]
    set esc_desc  [string map {% %25 \n " "} $description]
    set openvpn_spawn_id $spawn_id

    spawn pinentry-gnome3

    set result ""

    expect {
        "OK" { }
        timeout {
            set spawn_id $openvpn_spawn_id
            return ""
        }
        eof {
            set spawn_id $openvpn_spawn_id
            return ""
        }
    }

    send "SETTITLE $esc_title\r"
    expect { "OK" { } -re {^ERR} { } }

    send "SETDESC $esc_desc\r"
    expect { "OK" { } -re {^ERR} { } }

    send "SETPROMPT $prompt_label\r"
    expect { "OK" { } -re {^ERR} { } }

    send "GETPIN\r"
    expect {
        -re {^D (.*)\r} {
            set result $expect_out(1,string)
            expect "OK"
        }
        -re {^ERR} {
            set result ""
        }
        timeout {
            set result ""
        }
    }

    send "BYE\r"
    expect eof

    set spawn_id $openvpn_spawn_id

    return $result
}

set input_rules [load_rules $rules_file]
set use_custom_rules [expr {[llength $input_rules] > 0}]
set current_rule_index 0
set current_prompt_re "__NO_MORE_RULES__THIS_WILL_NOT_MATCH__"

if {$use_custom_rules} {
    set first_rule [lindex $input_rules 0]
    set current_prompt_re [literal_to_regex [lindex $first_rule 0]]
}

spawn sudo -A openvpn \
    --config $ovpn_file \
    --script-security 2

set timeout 120

expect {
    -re $current_prompt_re {
        if {!$use_custom_rules || $current_rule_index >= [llength $input_rules]} {
            exp_continue
        }

        set raw_prompt $expect_out(0,string)
        set rule [lindex $input_rules $current_rule_index]
        set prompt_text [lindex $rule 0]
        set input_type [lindex $rule 1]
        set input_value [lindex $rule 2]

        set answer ""
        if {$input_type eq "static"} {
            set answer $input_value
        } elseif {$input_type eq "prompt"} {
            set answer [get_secret \
                "OpenVPN Authentication" \
                "OpenVPN requires your input.\n$raw_prompt" \
                $input_value]

            if {$answer eq ""} {
                puts stderr "askpin: input prompt cancelled by user for expected text: $prompt_text"
                send "\003"
                exit 1
            }
        } else {
            puts stderr "askpin: invalid input type '$input_type'"
            send "\003"
            exit 1
        }

        send "$answer\r"

        incr current_rule_index
        if {$current_rule_index < [llength $input_rules]} {
            set next_rule [lindex $input_rules $current_rule_index]
            set current_prompt_re [literal_to_regex [lindex $next_rule 0]]
        } else {
            set current_prompt_re "__NO_MORE_RULES__THIS_WILL_NOT_MATCH__"
        }

        exp_continue
    }

    -re -nocase {(enter pin|token.*pin|pin for token)[^\r\n]*} {
        if {$use_custom_rules} {
            puts $expect_out(0,string)
            flush stdout
            exp_continue
        }

        set raw_prompt $expect_out(0,string)

        set pin [get_secret \
            "OpenVPN Authentication" \
            "OpenVPN requires your authentication PIN.\n$raw_prompt" \
            "PIN:"]

        if {$pin eq ""} {
            puts stderr "askpin: PIN entry cancelled by user"
            send "\003"
            exit 1
        }

        send "$pin\r"
        exp_continue
    }

    "Initialization Sequence Completed" {
        puts "Initialization Sequence Completed"
        flush stdout
        exp_continue
    }

    -re -nocase {(auth.failed|authentication failed|tls error|bad.*password|cannot.*resolve)} {
        puts stderr "askpin: VPN connection failed – $expect_out(0,string)"
        exit 1
    }

    -re {[^\r\n]+} {
        puts $expect_out(0,string)
        flush stdout
        exp_continue
    }

    eof {
        if {$use_custom_rules && $current_rule_index < [llength $input_rules]} {
            set missing_rule [lindex $input_rules $current_rule_index]
            set expected_text [lindex $missing_rule 0]
            puts stderr "askpin: expected input not found before openvpn exited: $expected_text"
            exit 1
        }
        exit 0
    }

    timeout {
        if {$use_custom_rules && $current_rule_index < [llength $input_rules]} {
            set missing_rule [lindex $input_rules $current_rule_index]
            set expected_text [lindex $missing_rule 0]
            puts stderr "askpin: expected input not found (timeout): $expected_text"
        } else {
            puts stderr "askpin: timeout waiting for VPN connection"
        }
        exit 1
    }
}
