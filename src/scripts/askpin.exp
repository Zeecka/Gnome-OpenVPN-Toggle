#!/usr/bin/expect -f

set ovpn_file [lindex $argv 0]
set rules_file [lindex $argv 1]
set debug_log [lindex $argv 2]
set auto_reconnect [expr {[info exists env(OPENVPN_TOGGLE_AUTO_RECONNECT)] && $env(OPENVPN_TOGGLE_AUTO_RECONNECT) eq "1"}]
set prompt_cache_file [expr {[info exists env(OPENVPN_TOGGLE_PROMPT_CACHE_FILE)] ? $env(OPENVPN_TOGGLE_PROMPT_CACHE_FILE) : ""}]

if {$ovpn_file eq ""} {
    puts stderr "Usage: askpin.exp <ovpn_file> ?rules_file? ?debug_log?"
    exit 1
}

puts "askpin: script-version=2026-03-08f"
puts "askpin: config=$ovpn_file rules_file=[expr {$rules_file eq "" ? "(none)" : $rules_file}]"
flush stdout

set openvpn_pid ""

if {$debug_log ne ""} {
    if {[catch {log_file -noappend $debug_log} log_err]} {
        puts stderr "askpin: failed to open debug log: $log_err"
    } else {
        exp_internal 1
        puts "askpin: debug logging enabled: $debug_log"
        flush stdout
    }
}

proc unescape_rule_field {value} {
    return [string map [list "\\\\t" "\t" "\\\\n" "\n" "\\\\r" "\r" "\\\\" "\\"] $value]
}

proc escape_rule_field {value} {
    return [string map [list "\\" "\\\\" "\t" "\\t" "\n" "\\n" "\r" "\\r"] $value]
}

proc load_rules {path} {
    if {$path eq "" || ![file exists $path]} {
        return {}
    }

    set fh [open $path r]
    set content [read $fh]
    close $fh

    set rules {}
    foreach line [split $content "\n"] {
        if {$line eq ""} {
            continue
        }

        set fields [split $line "\t"]
        if {[llength $fields] != 3} {
            continue
        }

        set expected [unescape_rule_field [lindex $fields 0]]
        set input_type [unescape_rule_field [lindex $fields 1]]
        set value [unescape_rule_field [lindex $fields 2]]

        if {$expected eq ""} {
            continue
        }

        if {$input_type ne "static" && $input_type ne "prompt"} {
            continue
        }

        lappend rules [list $expected $input_type $value]
    }

    return $rules
}

proc load_prompt_cache {path} {
    if {$path eq "" || ![file exists $path]} {
        return {}
    }

    if {[catch {
        set fh [open $path r]
        set content [read $fh]
        close $fh
    }]} {
        return {}
    }

    set cache_entries {}
    foreach line [split $content "\n"] {
        if {$line eq ""} {
            continue
        }

        set fields [split $line "\t"]
        if {[llength $fields] != 2} {
            continue
        }

        set expected [unescape_rule_field [lindex $fields 0]]
        set value [unescape_rule_field [lindex $fields 1]]
        if {$expected eq ""} {
            continue
        }

        lappend cache_entries $expected $value
    }

    return $cache_entries
}

proc store_prompt_cache_entry {path expected value} {
    if {$path eq "" || $expected eq ""} {
        return
    }

    array set cache_map [load_prompt_cache $path]
    set cache_map($expected) $value

    set rows {}
    foreach key [lsort [array names cache_map]] {
        lappend rows "[escape_rule_field $key]\t[escape_rule_field $cache_map($key)]"
    }

    catch {
        set fh [open $path w 0600]
        puts -nonewline $fh [join $rows "\n"]
        if {[llength $rows] > 0} {
            puts -nonewline $fh "\n"
        }
        close $fh
    }
}

proc literal_to_regex {text} {
    set trimmed [string trim $text]
    if {$trimmed eq ""} {
        return ""
    }

    set escaped ""
    set in_space 0

    foreach ch [split $trimmed ""] {
        if {[regexp {\s} $ch]} {
            if {!$in_space} {
                append escaped {\s+}
                set in_space 1
            }
            continue
        }

        set in_space 0
        if {[regexp {[][(){}.*+?^$\\|]} $ch]} {
            append escaped "\\$ch"
        } else {
            append escaped $ch
        }
    }

    append escaped {\s*}
    return $escaped
}

proc dialog_next_line {} {
    expect {
        -re {([^\r\n]*)\r\n} {
            return [string trim $expect_out(1,string)]
        }
        timeout {
            return "__TIMEOUT__"
        }
        eof {
            return "__EOF__"
        }
    }
}

proc dialog_wait_ok {} {
    while {1} {
        set line [dialog_next_line]

        if {$line eq "__TIMEOUT__" || $line eq "__EOF__"} {
            return 0
        }

        if {$line eq ""} {
            continue
        }

        if {[string match "OK*" $line]} {
            return 1
        }

        if {[string match "ERR*" $line]} {
            return 0
        }
    }
}

proc dialog_send_expect_ok {command} {
    send "$command\r"
    return [dialog_wait_ok]
}

proc dialog_get_input {} {
    set value ""

    send "GETPIN\r"

    while {1} {
        set line [dialog_next_line]

        if {$line eq "__TIMEOUT__" || $line eq "__EOF__"} {
            return ""
        }

        if {$line eq ""} {
            continue
        }

        if {[string match "ERR*" $line]} {
            return ""
        }

        if {[string match "D *" $line]} {
            set value [string range $line 2 end]
            continue
        }

        if {[string match "OK*" $line]} {
            return $value
        }
    }
}

proc request_value {description prompt_label} {
    global spawn_id timeout

    set esc_title [string map {% %25 \n " "} "OpenVPN Input"]
    set esc_desc [string map {% %25 \n " "} $description]
    set openvpn_spawn_id $spawn_id
    set old_timeout $timeout

    set timeout 30
    spawn pinentry-gnome3

    if {![dialog_wait_ok]} {
        set spawn_id $openvpn_spawn_id
        set timeout $old_timeout
        return ""
    }

    if {![dialog_send_expect_ok "SETTITLE $esc_title"]} {
        set spawn_id $openvpn_spawn_id
        set timeout $old_timeout
        return ""
    }

    if {![dialog_send_expect_ok "SETDESC $esc_desc"]} {
        set spawn_id $openvpn_spawn_id
        set timeout $old_timeout
        return ""
    }

    if {![dialog_send_expect_ok "SETPROMPT $prompt_label"]} {
        set spawn_id $openvpn_spawn_id
        set timeout $old_timeout
        return ""
    }

    set result [dialog_get_input]

    catch {
        send "BYE\r"
        expect eof
    }

    set spawn_id $openvpn_spawn_id
    set timeout $old_timeout

    return $result
}

proc terminate_openvpn_tree {} {
    global openvpn_pid

    if {$openvpn_pid eq ""} {
        return
    }

    catch {exec kill -TERM -- -$openvpn_pid}
    catch {exec kill -TERM $openvpn_pid}
    catch {exec pkill -TERM -P $openvpn_pid}

    after 150

    catch {exec kill -KILL -- -$openvpn_pid}
    catch {exec kill -KILL $openvpn_pid}
    catch {exec pkill -KILL -P $openvpn_pid}
}

proc handle_stop_signal {signal_name} {
    puts "askpin: received $signal_name; terminating openvpn subprocess"
    flush stdout
    terminate_openvpn_tree
    exit 0
}

set input_rules [load_rules $rules_file]
set use_rules [expr {[llength $input_rules] > 0}]
set current_rule_index 0
set current_expected_re "__NO_MATCH__"
array set prompt_cache [load_prompt_cache $prompt_cache_file]

if {$use_rules} {
    set first_rule [lindex $input_rules 0]
    set current_expected_re [literal_to_regex [lindex $first_rule 0]]
    puts "askpin: loaded [llength $input_rules] configured input rule(s)"
    if {$auto_reconnect} {
        puts "askpin: automatic reconnect enabled; cached prompt answers will be reused when available"
    }
    puts "askpin: waiting for input #1 regex={$current_expected_re}"
    flush stdout
} else {
    puts "askpin: no configured input rules; running passthrough"
    flush stdout
}

spawn sudo -A openvpn \
    --config $ovpn_file \
    --script-security 2

set openvpn_pid [exp_pid]

trap {handle_stop_signal SIGTERM} SIGTERM
trap {handle_stop_signal SIGINT} SIGINT
trap {handle_stop_signal SIGHUP} SIGHUP

set timeout -1

expect {
    -nocase -re $current_expected_re {
        if {!$use_rules || $current_rule_index >= [llength $input_rules]} {
            exp_continue
        }

        set observed [string trim $expect_out(0,string)]
        set rule [lindex $input_rules $current_rule_index]
        set expected_text [lindex $rule 0]
        set input_type [lindex $rule 1]
        set input_value [lindex $rule 2]

        set response ""
        if {$input_type eq "static"} {
            puts "askpin: matched input #[expr {$current_rule_index + 1}] type=static expected={$expected_text}"
            flush stdout
            set response $input_value
        } else {
            if {$auto_reconnect && [info exists prompt_cache($expected_text)] && $prompt_cache($expected_text) ne ""} {
                puts "askpin: matched input #[expr {$current_rule_index + 1}] type=prompt expected={$expected_text} using cached response"
                flush stdout
                set response $prompt_cache($expected_text)
            } else {
                puts "askpin: matched input #[expr {$current_rule_index + 1}] type=prompt expected={$expected_text}"
                flush stdout

                set response [request_value \
                    "OpenVPN requires an input.\n$observed" \
                    $input_value]

                if {$response ne ""} {
                    set prompt_cache($expected_text) $response
                    store_prompt_cache_entry $prompt_cache_file $expected_text $response
                }
            }

            if {$response eq ""} {
                puts stderr "askpin: prompt input cancelled/unavailable for expected text: $expected_text"
                send "\003"
                terminate_openvpn_tree
                exit 1
            }
        }

        send "$response\r"

        incr current_rule_index
        if {$current_rule_index < [llength $input_rules]} {
            set next_rule [lindex $input_rules $current_rule_index]
            set current_expected_re [literal_to_regex [lindex $next_rule 0]]
            puts "askpin: waiting for input #[expr {$current_rule_index + 1}] regex={$current_expected_re}"
        } else {
            set current_expected_re "__NO_MATCH__"
            puts "askpin: all configured input rules processed"
        }
        flush stdout

        exp_continue
    }

    -re {(^|\r\n)Initialization Sequence Completed(\r\n|$)} {
        puts "Initialization Sequence Completed"
        flush stdout
        exp_continue
    }

    -re {[^\n]+} {
        puts $expect_out(0,string)
        flush stdout
        exp_continue
    }

    eof {
        if {$use_rules && $current_rule_index < [llength $input_rules]} {
            set missing_rule [lindex $input_rules $current_rule_index]
            set expected_text [lindex $missing_rule 0]
            puts stderr "askpin: expected input not found before openvpn exited: $expected_text"
            exit 1
        }
        set openvpn_pid ""
        exit 0
    }
}
